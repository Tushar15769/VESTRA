# =====================================================================
# VESTRA — Ask beyond the video.
# Environment Configuration
# =====================================================================

# LLM Provider Configuration
# Supported providers: 'groq' (default & recommended), 'ollama', 'huggingface', 'openai_compatible', 'mock'
LLM_PROVIDER=groq

# Model Name
# For Groq: openai/gpt-oss-20b
# For Ollama: llama3.1
# For Hugging Face: meta-llama/Llama-3.1-8B-Instruct
MODEL_NAME=openai/gpt-oss-20b

# API Keys
# Required if LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here

# Required if LLM_PROVIDER=huggingface
HUGGINGFACE_API_TOKEN=your_hf_token_here

# Required if LLM_PROVIDER=openai_compatible
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.together.xyz/v1

# Ollama Host (if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# RAG & Embeddings Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
TEMPERATURE=0.2
MAX_TOKENS=1024

# Data Directories
DATA_DIR=data
TRANSCRIPTS_DIR=data/transcripts
VECTORSTORES_DIR=data/vectorstores
